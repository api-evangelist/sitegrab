{"openapi":"3.0.3","info":{"title":"SiteGrab Screenshot API","description":"Capture pixel-perfect screenshots of any webpage via a simple REST API. Supports JPEG, PNG, full-page capture modes with custom viewport sizes. Free tier: 50 screenshots/month.","version":"1.0.0","contact":{"url":"https://sitegrab.dev/contact"}},"servers":[{"url":"https://api.sitegrab.dev","description":"Production API server"},{"url":"https://sitegrab.dev","description":"Website"}],"paths":{"/v1/screenshot":{"post":{"summary":"Capture a screenshot","description":"Captures a screenshot of a given URL and returns the image bytes. Supports JPEG, PNG, full-page, and custom viewport sizes.","operationId":"captureScreenshot","security":[{"ApiKeyAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri","description":"The webpage URL to capture","example":"https://example.com"},"format":{"type":"string","enum":["jpeg","png"],"default":"jpeg","description":"Image format for the screenshot"},"full_page":{"type":"boolean","default":false,"description":"Capture the full scrollable page"},"viewport":{"type":"object","properties":{"width":{"type":"integer","default":1280,"example":1920},"height":{"type":"integer","default":720,"example":1080}},"description":"Browser viewport dimensions"}}}}}},"responses":{"200":{"description":"Screenshot image bytes","content":{"image/png":{},"image/jpeg":{}}},"400":{"description":"Missing URL parameter"},"401":{"description":"Missing or invalid API key"},"429":{"description":"Rate limit exceeded"}}},"get":{"summary":"Quick screenshot via query params","description":"Captures a screenshot from a URL passed as a query parameter. Returns immediately with a pending status.","operationId":"quickScreenshot","security":[{"ApiKeyAuth":[]},{"ApiKeyParam":[]}],"parameters":[{"name":"url","in":"query","required":true,"schema":{"type":"string","format":"uri"},"description":"URL to capture"},{"name":"key","in":"query","required":false,"schema":{"type":"string"},"description":"API key (alternative to X-API-Key header)"}],"responses":{"202":{"description":"Accepted — capture queued","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"status":{"type":"string","enum":["pending"]}}}}}},"401":{"description":"Missing API key"}}}},"/v1/keys":{"post":{"summary":"Create an API key","description":"Generates a new API key. Free tier: 50 screenshots/month. Rate-limited to 3 keys per hour per IP.","operationId":"createApiKey","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"tier":{"type":"string","enum":["free","starter","pro","business"],"default":"free","description":"Subscription tier"}}}}}},"responses":{"200":{"description":"API key created","content":{"application/json":{"schema":{"type":"object","properties":{"api_key":{"type":"string","example":"lf_abc123..."},"tier":{"type":"string"},"limit":{"type":"integer","description":"Monthly screenshot limit"}}}}}},"429":{"description":"Rate limit exceeded (max 3 keys per hour)"}}}},"/v1/health":{"get":{"summary":"Health check","description":"Returns API health status and version information.","operationId":"healthCheck","responses":{"200":{"description":"Service is healthy","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["ok"]},"version":{"type":"string"}}}}}}}}},"/v1/usage":{"get":{"summary":"Get usage stats","description":"Returns the current month's screenshot count and rate limit status for a given API key.","operationId":"getUsage","security":[{"ApiKeyAuth":[]}],"responses":{"200":{"description":"Usage statistics","content":{"application/json":{"schema":{"type":"object","properties":{"count":{"type":"integer"},"limit":{"type":"integer"},"remaining":{"type":"integer"}}}}}},"401":{"description":"Missing API key"}}}},"/v1/checkout":{"post":{"summary":"Create Stripe checkout session","description":"Creates a Stripe Checkout Session for upgrading to a paid tier.","operationId":"createCheckout","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["tier","api_key"],"properties":{"tier":{"type":"string","enum":["starter","pro","business"],"description":"Target tier"},"api_key":{"type":"string","description":"Existing API key to upgrade"}}}}}},"responses":{"200":{"description":"Checkout URL created","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"}}}}}}}}},"/v1/webhook":{"post":{"summary":"Stripe webhook endpoint","description":"Receives Stripe payment events to upgrade API keys on successful payment.","operationId":"stripeWebhook","parameters":[{"name":"Stripe-Signature","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Webhook processed"},"400":{"description":"Invalid signature"}}}},"/docs":{"get":{"summary":"Documentation page","description":"HTML documentation with code examples in 6 languages.","operationId":"getDocs","responses":{"200":{"description":"HTML documentation","content":{"text/html":{}}}}}},"/signup":{"get":{"summary":"Sign up page","description":"HTML sign-up page with Google OAuth login and direct key generation.","operationId":"getSignup","responses":{"200":{"description":"HTML signup page","content":{"text/html":{}}}}}},"/":{"get":{"summary":"Home page","description":"HTML landing page with hero, features, pricing table, and quickstart guide.","operationId":"getHome","responses":{"200":{"description":"HTML landing page","content":{"text/html":{}}}}}}},"components":{"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"X-API-Key","description":"Your SiteGrab API key"},"ApiKeyParam":{"type":"apiKey","in":"query","name":"key","description":"API key as query parameter (alternative to header)"}}},"tags":[{"name":"Screenshots","description":"Capture webpage screenshots"},{"name":"Account","description":"API key management"},{"name":"Billing","description":"Subscription and payment management"},{"name":"Status","description":"Health check and usage monitoring"}],"externalDocs":{"description":"Full documentation with code examples","url":"https://sitegrab.dev/docs"}}